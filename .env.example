# ==========================================
# Resume & Thread - Local Engine Configuration
# ==========================================

# Port for local Mastra orchestration server
PORT=4141
HOST=127.0.0.1
NODE_ENV=development

# Local Open-Weight Inference Engine (Ollama / Llama.cpp)
OLLAMA_URL=http://127.0.0.1:11434
DEFAULT_GEMMA_MODEL=gemma2:2b-instruct
HIGH_ACCURACY_GEMMA_MODEL=gemma2:9b-instruct

# Local Storage Directory for Tailored Resumes & Master Data
DATA_DIR=./data
OUTPUT_DIR=./data/tailored_resumes

# Chrome Extension Origin Whitelist for Local Server CORS
ALLOWED_ORIGIN=chrome-extension://*
